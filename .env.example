# Groq API Keys (get free at console.groq.com — create 3 accounts for 3 keys)
GROQ_API_KEY_1=your_first_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here

# Bing Search API (optional but recommended — free 1000 calls/month)
# Get at: portal.azure.com → Create Resource → Bing Search v7
BING_API_KEY=your_bing_key_here

# App settings
DEBUG=false
PORT=5000
